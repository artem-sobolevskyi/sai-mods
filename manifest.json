{
  "manifest_version": 3,
  "name": "SAI Mods",
  "version": "1.2.0",
  "description": "Site appearance mods with GitHub updates, remote mods, and YouTube Music player bar layouts.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "SAI Mods",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared.js", "src/content/custom-mods.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["src/content/ytmusic-classic.js", "src/content/ytmusic-modern.js"],
      "run_at": "document_start"
    }
  ]
}
